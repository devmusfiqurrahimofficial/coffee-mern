# ---- Local development values ----
# Copy to frontend/.env for local dev. In production (Vercel) set these in
# Project Settings → Environment Variables. No secrets here — Vite bakes
# VITE_* values into the public bundle, so only public identifiers belong.

# URL of your hosted API server (Express + MongoDB).
API_KEY=http://localhost:5000

# Admin account emails, comma-separated. Only these accounts can open /dashboard.
# Real enforcement is backend requireAdmin; this only hides the link.
VITE_ADMIN_EMAILS=you@example.com

# Firebase web config (public identifiers — access enforced by Firebase
# Security Rules + backend JWT checks, never by hiding these).
FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
