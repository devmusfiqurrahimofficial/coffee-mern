# ---- Local development values (checked into git on purpose) ----
# In production (Netlify) these are set in Site settings → Environment variables.

# URL of your hosted API server (Express + MongoDB).
# Leave empty/unset for local development (falls back to http://localhost:5000).
VITE_API_URL=http://localhost:5000

# Admin account emails, comma-separated. Only these accounts can open /dashboard.
VITE_ADMIN_EMAILS=musfikurr93@gmail.com
