# ---- backend/.env.example ------------------------------------------------
# Copy to backend/.env for local development. On Render, set the same keys
# in the service dashboard (Environment tab).

# MongoDB Atlas connection string (the app uses database "mydatabase").
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Secret used to sign JWTs for the /jwt endpoint.
JWT_SECRET=replace-with-a-long-random-secret

# Public URL of this API server, used to build absolute image URLs.
# Locally: http://localhost:5000 — on Render: https://your-service.onrender.com
BASE_URL=http://localhost:5000

# Port the server listens on. Render sets this automatically; default 5000.
# PORT=5000
