# ---- backend/.env.example ------------------------------------------------
# Copy to backend/.env for local development. On Render, set the same keys
# in the service dashboard (Environment tab). NEVER commit the real .env.

# MongoDB Atlas connection string (the app uses database "mydatabase").
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Secret used to sign JWTs for the /jwt endpoint.
# Generate: openssl rand -hex 64 (must be 64+ chars).
JWT_SECRET=replace-with-a-long-random-secret

# Public URL of this API server, used to build absolute image URLs.
# Locally: http://localhost:5000 — on Render: https://your-service.onrender.com
BASE_URL=http://localhost:5000

# Exact deployed frontend origin (CORS allow-list, e.g. https://your-site.netlify.app)
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated admin emails (no default — empty means no admins)
ADMIN_EMAILS=you@example.com

# Set on Render/hosting: NODE_ENV=production (disables localhost CORS origins)
# NODE_ENV=development

# Optional: firebase-admin service-account JSON for verifying POST /jwt
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Port the server listens on. Render sets this automatically; default 5000.
# PORT=5000
