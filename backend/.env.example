# MongoDB connection string used by the API.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Existing application JWT setting (used by the current /jwt endpoint).
JWT_SECRET=replace-with-a-long-random-secret

# Firebase Authentication and Storage use the signed-in user's ID token.
# No Firebase Admin service-account key is required for blog publishing.
FIREBASE_STORAGE_BUCKET=coffee-mern.firebasestorage.app
# Optional: override the public key configured in frontend/firebase.config.js.
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key